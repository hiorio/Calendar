  "devDependencies": {
    "@expo/image-utils": "^0.11.4",
    "@types/react": "~19.2.2",
    "agent-device": "0.21.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "supabase": "^2.109.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:studio": "supabase status -o json",
    "db:env": "node scripts/write-env.mjs",
    "db:smoke": "node scripts/smoke-local.mjs",
    "test:unit": "node scripts/unit-check.mjs",
    "test:regression": "node scripts/event-regression-check.mjs && node scripts/client-regression-check.mjs && node scripts/notification-regression-check.mjs && node scripts/widget-regression-check.mjs && node scripts/widget-sync-regression-check.mjs && node scripts/sticker-regression-check.mjs",
    "db:regression": "node scripts/backend-db-regression.mjs",
    "test:sql-embedded": "npx --yes deno@2.9.6 run --no-lock --node-modules-dir=none --allow-read --allow-env scripts/backend-embedded-check.mjs",
    "typecheck:worker": "npx --yes deno@2.9.6 check --no-lock --config supabase/functions/deno.json supabase/functions/notification-worker/index.ts",
    "icons": "node scripts/make-icons.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "deploy:check": "node scripts/check-deploy-env.mjs",
    "links:generate": "node scripts/write-link-associations.mjs",
    "sentry:upload-update": "sentry-expo-upload-sourcemaps dist",
    "web:export": "expo export --platform web"
  },
  "engines": {
    "node": ">=22.18"
  },
  "private": true
}
