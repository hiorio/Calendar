# Supabase 프로젝트 설정 > API에서 복사합니다.
# EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 포함되는 공개 설정입니다.
# anon key는 공개 가능한 값이지만 데이터 보호는 반드시 RLS가 담당해야 합니다.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# EAS 환경마다 preview와 production 값을 분리합니다.
APP_VARIANT=preview
EAS_PROJECT_ID=00000000-0000-4000-8000-000000000000
APP_IOS_BUNDLE_IDENTIFIER=com.yourcompany.timeline.preview

# 알림 워커와 1분 스케줄 연결을 확인한 뒤 true로 바꿉니다.
EXPO_PUBLIC_PUSH_ENABLED=false

# 프로덕션 유니버설 링크의 HTTPS 원점. preview에서는 비워도 됩니다.
# EXPO_PUBLIC_UNIVERSAL_LINK_BASE_URL=https://timeline.example.com
# APPLE_TEAM_ID=ABCDE12345

# Sentry 프로젝트를 연결할 때 설정합니다. DSN은 공개 값입니다.
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ORG=your-org
# SENTRY_PROJECT=timeline
# SENTRY_AUTH_TOKEN은 저장소나 .env에 두지 말고 EAS의 secret 환경 변수로 등록합니다.

# service_role key와 워커 secret은 앱 환경에 넣지 말고 Edge Function secret으로만 둡니다.
